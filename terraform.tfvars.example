name   = "support_agent"
region = "eu-west-1"

model_id = "global.anthropic.claude-sonnet-5-5" # or "eu.anthropic.claude-sonnet-5-5" to keep inference in EU Regions

# Start in LOG_ONLY, review decisions, then switch to ENFORCE.
policy_enforcement_mode = "LOG_ONLY"

# No-egress networking (default). ~$32/month idle with one endpoint AZ.
runtime_network_mode = "VPC"
vpc_az_ids           = ["euw1-az1", "euw1-az2"] # must be AgentCore-supported AZ IDs in your region
endpoint_az_count    = 1
tools_lambda_in_vpc  = false # true = tools can't reach the internet either

# Agent-enforced model limits (shared across runtime instances).
model_tokens_per_minute = 150000
model_tokens_per_day    = 3000000 # ~$8/day on Sonnet 5.5

# Built by agent/package.sh; the runtime is created once this file exists.
# agent_code_zip = "agent/dist/agent.zip"
