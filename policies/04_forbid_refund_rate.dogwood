// Rate limit: at most ${max_refunds_per_hour} refund attempts per rolling hour.
// count includes the request being authorized, so attempt N+1 is the first denied.
// forbid always overrides permit.
forbid (
    principal,
    action == AgentCore::Action::"${orders}___issue_refund",
    resource == AgentCore::Gateway::"${gateway_arn}"
)
when temporal {
    exists (n: Long).
        (count for (t: Timepoint).
            where (formerly within 1h (AgentCore::Action::"${orders}___issue_refund"::request{ eventResource: resource } && tp(t)))) == n
        && n > ${max_refunds_per_hour}
};
