// Ordering: the agent may only ask to refund an order it has actually looked
// up (successfully) in the last ${approval_window} of this policy session.
permit (
    principal,
    action == AgentCore::Action::"${orders}___request_refund_approval",
    resource == AgentCore::Gateway::"${gateway_arn}"
)
when temporal {
    formerly within ${approval_window} AgentCore::Action::"${orders}___lookup_order"::response{
        eventResource:  resource,
        input.order_id: context.input.order_id,
        output.found:   true
    }
}
when {
    context.input.amount_cents > 0
};
