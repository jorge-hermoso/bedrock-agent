// Order lookup needs both IDs; 06 limits how many distinct customers it can touch.
// (An unconditional permit is rejected by validation as overly permissive.)
permit (
    principal,
    action == AgentCore::Action::"${orders}___lookup_order",
    resource == AgentCore::Gateway::"${gateway_arn}"
)
when {
    context.input.order_id != "" && context.input.customer_id != ""
};
