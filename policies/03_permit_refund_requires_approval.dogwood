// Prerequisite: issue_refund is allowed only for an amount under the hard cap
// AND only if request_refund_approval returned approved=true for the same
// order and amount within the last ${approval_window}. Each approval is good for
// one refund: a completed refund of that order since the approval consumes it.
permit (
    principal,
    action == AgentCore::Action::"${orders}___issue_refund",
    resource == AgentCore::Gateway::"${gateway_arn}"
)
when temporal {
    !AgentCore::Action::"${orders}___issue_refund"::response{
        eventResource:  resource,
        input.order_id: context.input.order_id
    }
    since within ${approval_window} AgentCore::Action::"${orders}___request_refund_approval"::response{
        eventResource:      resource,
        input.order_id:     context.input.order_id,
        input.amount_cents: context.input.amount_cents,
        output.approved:    true
    }
}
when {
    context.input.amount_cents > 0
    && context.input.amount_cents <= ${max_refund_cents}
};
